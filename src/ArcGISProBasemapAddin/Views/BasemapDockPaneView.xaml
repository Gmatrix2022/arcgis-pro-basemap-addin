<UserControl x:Class="ArcGISProBasemapAddin.Views.BasemapDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="360">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
    <StackPanel>
      <!-- 顶部标题与合规/离线状态栏 -->
      <Border CornerRadius="6" Padding="10" Margin="0,0,0,10" Background="#1E293B">
        <StackPanel>
          <TextBlock Text="GeoAI 多源底图与离线矢量工作台" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" />
          <TextBlock Text="Mapsforge 0.25.0 无头拆层渲染 · GCJ-02→WGS-84 实时纠偏" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,8" />
          <CheckBox Content="纯离线断网竞赛模式 (阻断一切外部网络请求)"
                    IsChecked="{Binding OfflineMode, Mode=TwoWay}"
                    Foreground="#E2E8F0" Margin="0,2,0,4" />
          <CheckBox Content="当前视野含中国国界/全图 (启用国界触发制白名单锁)"
                    IsChecked="{Binding HasNationalBorderInView, Mode=TwoWay}"
                    Foreground="#FCD34D" Margin="0,2,0,0" />
        </StackPanel>
      </Border>

      <!-- 一键黄金三层复合底图栈 -->
      <GroupBox Header="1. 户外制图黄金三层复合栈 (一键装配)" Margin="0,0,0,10" Padding="8">
        <StackPanel>
          <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,6">
            自动按黄金顺序装配：① 高德实时纠偏卫星底图 (WGS-84) → ② 滇池 N24+N25 跨纬线无缝拼接 50m 稀疏等高线透明层 → ③ 云南 LocusSat 分级路网与山峰注记透明层（自动剔除保护区绿斜纹）。
          </TextBlock>
          <Button Content="⚡ 一键装配：滇池-西山黄金三层复合底图栈"
                  Command="{Binding LoadGoldenThreeLayerCommand}"
                  Height="32" FontWeight="SemiBold" />
        </StackPanel>
      </GroupBox>

      <!-- 在线多源底图与实时纠偏 -->
      <GroupBox Header="2. 在线多源底图 (GCJ-02 实时重采样至 WGS-84)" Margin="0,0,0,10" Padding="8">
        <StackPanel>
          <TextBlock Text="选择在线图源：" FontSize="11.5" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding OnlineSources}"
                    SelectedItem="{Binding SelectedOnlineSource, Mode=TwoWay}"
                    DisplayMemberPath="Title"
                    Margin="0,0,0,8" />
          <Button Content="加载选中在线底图至受管图层组"
                  Command="{Binding LoadOnlineBasemapCommand}"
                  Height="28" />
        </StackPanel>
      </GroupBox>

      <!-- 本地 Mapsforge (.map) 离线矢量拆层引擎 -->
      <GroupBox Header="3. Mapsforge (.map) 离线矢量地图自定义拆层" Margin="0,0,0,10" Padding="8">
        <StackPanel>
          <TextBlock Text="离线 .map 文件路径（多文件用分号 ; 分隔实现无缝拼接）：" FontSize="11.5" Margin="0,0,0,4" />
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SelectedMapFiles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="4,2" />
            <Button Grid.Column="1" Content="浏览..." Command="{Binding BrowseMapFilesCommand}"
                    Margin="6,0,0,0" Padding="10,2" />
          </Grid>

          <Button Content="🔍 探查 .map 文件头与中心瓦片要素 (自动识别纯等高线包)"
                  Command="{Binding ProbeMapCommand}"
                  Height="26" Margin="0,0,0,6" />
          <TextBlock Text="{Binding ProbeSummary}" TextWrapping="Wrap" FontSize="11" Foreground="#0284C7" Margin="0,0,0,8" />

          <TextBlock Text="Mapsforge v5 渲染主题 (内置 dp 单位流式剥离)：" FontSize="11.5" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding ThemeOptions}"
                    SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                    Margin="0,0,0,8" />

          <TextBlock Text="排除规则分类 (excludeCats，逗号分隔，如 contour,hatch)：" FontSize="11.5" Margin="0,0,0,4" />
          <TextBox Text="{Binding ExcludeCats, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Padding="4,2" Margin="0,0,0,8" />

          <CheckBox Content="以 PNG32 透明背景渲染 (用于叠加在卫星底图上方)"
                    IsChecked="{Binding TransparentOverlay, Mode=TwoWay}"
                    Margin="0,0,0,8" />

          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="图层初始透明度 (%)：" FontSize="11.5" />
            <TextBlock Text="{Binding LayerTransparency, StringFormat={}{0:F0}%}" FontWeight="Bold" Margin="6,0,0,0" />
          </StackPanel>
          <Slider Minimum="0" Maximum="80" Value="{Binding LayerTransparency, Mode=TwoWay}"
                  TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,10" />

          <Button Content="挂载 Mapsforge 离线矢量图层"
                  Command="{Binding LoadCustomMapsforgeLayerCommand}"
                  Height="30" FontWeight="SemiBold" />
        </StackPanel>
      </GroupBox>

      <!-- 底部实时反馈栏 -->
      <Border CornerRadius="4" Padding="8" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1">
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="11.5" Foreground="#0F172A" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
